{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/recruitment/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Space Mono|Caveat))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Space Mono, Caveat."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|src|alt|size|tone|status|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, src, alt, size, tone, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:orange|green|blue|ink)$/]",
        "message": "<Avatar> tone must be one of 'orange' | 'green' | 'blue' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|offline)$/]",
        "message": "<Avatar> status must be one of 'online' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sector|zzp|new|info|neutral)$/]",
        "message": "<Badge> tone must be one of 'sector' | 'zzp' | 'new' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|brand|outline|ghost|whatsapp)$/]",
        "message": "<Button> variant must be one of 'primary' | 'brand' | 'outline' | 'ghost' | 'whatsapp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecruiterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tagline|role|initials|photo|tone|placements|status|whatsappLabel|style|key|ref|className|style|children)$/]",
        "message": "<RecruiterCard> doesn't accept that prop. Declared props: name, tagline, role, initials, photo, tone, placements, status, whatsappLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecruiterCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:orange|green|blue|ink)$/]",
        "message": "<RecruiterCard> tone must be one of 'orange' | 'green' | 'blue' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecruiterCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|offline)$/]",
        "message": "<RecruiterCard> status must be one of 'online' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|cta|scheme|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SectorCard> doesn't accept that prop. Declared props: title, items, cta, scheme, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectorCard'] > JSXAttribute[name.name='scheme'] > Literal[value!=/^(?:bouw|tech|office)$/]",
        "message": "<SectorCard> scheme must be one of 'bouw' | 'tech' | 'office'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|value|placeholder|rows|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, hint, value, placeholder, rows, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|type|value|placeholder|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, error, type, value, placeholder, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VacatureBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|key|ref|className|style|children)$/]",
        "message": "<VacatureBadge> doesn't accept that prop. Declared props: label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='VacatureBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sector|zzp|new|info|neutral)$/]",
        "message": "<VacatureBadge> tone must be one of 'sector' | 'zzp' | 'new' | 'info' | 'neutral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
